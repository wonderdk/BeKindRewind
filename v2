<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Be Kind, Rewind — Video Rental</title>
<link rel="icon" type="image/svg+xml" href="favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pacifico&family=Permanent+Marker&display=swap" rel="stylesheet">
<style>
:root{
  --room:#1c1410;        /* back-of-shop shadow */
  --wood:#6b4a2c;        /* pine shelf */
  --wood-dark:#4a3018;
  --wood-edge:#8a6238;
  --lamp:#e8d5a8;        /* tungsten glow */
  --paper:#f2e8d0;       /* index cards */
  --ink:#2b2118;
  --sticker-red:#b3402a;
  --sticker-yellow:#e9c832;
  --felt:#2d4a3e;        /* worn carpet green */
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto}
  *{transition:none !important;animation:none !important}
}
body{
  background:
    radial-gradient(ellipse 120% 60% at 50% -10%, rgba(232,213,168,.10), transparent 60%),
    linear-gradient(180deg, #241a12 0%, var(--room) 30%);
  background-color:var(--room);
  color:var(--paper);
  font-family:system-ui,-apple-system,"Segoe UI",sans-serif;
  min-height:100vh;
}

/* ── Storefront ── */
.storefront{
  text-align:center;
  padding:46px 16px 22px;
  position:relative;
}
.neon{
  font-family:'Pacifico',cursive;
  font-size:clamp(34px,7vw,64px);
  color:#ffd9e8;
  text-shadow:
    0 0 6px #ff7ab8, 0 0 18px #ff4f9e, 0 0 42px #e0257c,
    0 2px 0 rgba(0,0,0,.5);
  line-height:1.1;
}
.neon-sub{
  display:inline-block;
  margin-top:10px;
  font-family:'Permanent Marker',cursive;
  font-size:13px;
  letter-spacing:.45em;
  text-indent:.45em;
  color:#9fe8ff;
  text-shadow:0 0 5px #37c4f0, 0 0 16px #1493c4;
}
.hours-card{
  display:inline-block;
  margin-top:22px;
  background:var(--paper);
  color:var(--ink);
  font-family:'Permanent Marker',cursive;
  font-size:12px;
  padding:8px 16px 9px;
  transform:rotate(-1.6deg);
  box-shadow:0 3px 8px rgba(0,0,0,.5);
  position:relative;
}
.hours-card::before{ /* tape */
  content:'';
  position:absolute;top:-8px;left:50%;transform:translateX(-50%) rotate(2deg);
  width:52px;height:14px;background:rgba(255,255,240,.28);
  border-left:1px dashed rgba(0,0,0,.12);border-right:1px dashed rgba(0,0,0,.12);
}
.back-link{
  position:absolute;top:14px;left:14px;
  background:var(--paper);color:var(--ink);
  font-family:'Permanent Marker',cursive;font-size:11px;
  padding:6px 10px;text-decoration:none;
  transform:rotate(-2deg);
  box-shadow:0 2px 6px rgba(0,0,0,.5);
}
.back-link:hover{transform:rotate(0deg)}

/* ── Counter: search ── */
.counter{
  max-width:520px;margin:26px auto 8px;padding:0 16px;
}
.search-card{
  background:var(--paper);
  padding:12px 14px 14px;
  transform:rotate(.6deg);
  box-shadow:0 4px 10px rgba(0,0,0,.55);
}
.search-card label{
  display:block;
  font-family:'Permanent Marker',cursive;
  color:var(--ink);font-size:12px;margin-bottom:6px;
}
.search-card input{
  width:100%;
  background:#fffdf4;
  border:1px solid #b9ab8a;
  border-radius:2px;
  padding:9px 12px;
  font-size:15px;
  color:var(--ink);
  outline:none;
  background-image:repeating-linear-gradient(180deg, transparent, transparent 26px, rgba(179,64,42,.15) 27px);
}
.search-card input:focus{border-color:var(--sticker-red)}

/* ── Aisle sign nav ── */
.aisle-nav{
  position:sticky;top:0;z-index:50;
  display:flex;gap:10px;
  overflow-x:auto;
  padding:14px 16px 10px;
  background:linear-gradient(180deg, rgba(28,20,16,.96) 70%, transparent);
  scrollbar-width:none;
}
.aisle-nav::-webkit-scrollbar{display:none}
.aisle-sign{
  flex:0 0 auto;
  font-family:'Permanent Marker',cursive;
  font-size:13px;
  color:var(--ink);
  background:var(--sticker-yellow);
  padding:7px 14px 8px;
  text-decoration:none;
  box-shadow:0 3px 6px rgba(0,0,0,.5);
  transform:rotate(-1.2deg);
  white-space:nowrap;
}
.aisle-sign:nth-child(2n){background:#f0913e;transform:rotate(1.1deg)}
.aisle-sign:nth-child(3n){background:#e86a8a;transform:rotate(-.7deg)}
.aisle-sign:hover{filter:brightness(1.08)}
.aisle-sign .count{font-size:10px;opacity:.65;margin-left:5px}

/* ── Shelf sections ── */
.aisle{max-width:1200px;margin:0 auto;padding:34px 16px 8px}
.aisle-header{display:flex;align-items:baseline;gap:14px;margin-bottom:18px}
.aisle-title{
  font-family:'Permanent Marker',cursive;
  font-size:clamp(20px,3.4vw,28px);
  color:var(--lamp);
  text-shadow:0 0 22px rgba(232,213,168,.35);
}
.aisle-count{font-size:12px;color:#8a7a60}
.shelf-unit{
  border-radius:4px;
  padding:0 10px;
  background:
    linear-gradient(90deg, rgba(0,0,0,.45), transparent 6%, transparent 94%, rgba(0,0,0,.45)),
    radial-gradient(ellipse 70% 40% at 50% 0%, rgba(232,213,168,.13), transparent 70%),
    linear-gradient(180deg, #2a1d12, #221709);
  box-shadow:inset 0 0 40px rgba(0,0,0,.6), 0 6px 18px rgba(0,0,0,.5);
  border:1px solid #3a2a18;
}
.shelf-row{
  display:flex;gap:14px;
  overflow-x:auto;
  padding:26px 14px 0;
  /* the wood board the cases stand on */
  border-bottom:14px solid var(--wood);
  border-image:linear-gradient(180deg, var(--wood-edge), var(--wood) 30%, var(--wood-dark)) 1;
  scrollbar-width:thin;
  scrollbar-color:var(--wood-dark) transparent;
}
.shelf-row:last-child{margin-bottom:0}

/* ── Cases ── */
.case{
  flex:0 0 auto;
  width:118px;
  cursor:pointer;
  position:relative;
  transition:transform .18s ease;
  transform-origin:bottom center;
  background:none;border:none;padding:0;text-align:left;
}
.case:hover,.case:focus-visible{transform:translateY(-8px) rotate(-1deg)}
.case:focus-visible{outline:2px solid var(--sticker-yellow);outline-offset:3px}
.case-art{
  width:118px;height:177px;
  border-radius:2px 4px 4px 2px;
  position:relative;
  overflow:hidden;
  background:linear-gradient(160deg,#3a3a4a,#20202c);
  box-shadow:2px 4px 8px rgba(0,0,0,.65);
  border-left:5px solid #111; /* spine */
}
.case-art.f-DVD{border-left-color:#3f3f46}
.case-art.f-Blu-ray{border-left-color:#1f5fd6}
.case-art.f-4KUltraHD{border-left-color:#000}
.case-art.f-VHS{border-left-color:#0a0a0a;border-left-width:8px}
.case-art img{width:100%;height:100%;object-fit:cover;display:block}
.case-art .no-art{
  position:absolute;inset:0;
  display:flex;align-items:center;justify-content:center;
  padding:10px;text-align:center;
  font-family:'Permanent Marker',cursive;
  font-size:12px;color:var(--paper);
}
.case-art::after{ /* plastic sheen */
  content:'';position:absolute;inset:0;
  background:linear-gradient(115deg, rgba(255,255,255,.18) 0%, rgba(255,255,255,.04) 22%, transparent 40%);
  pointer-events:none;
}
.sticker{
  position:absolute;top:6px;right:6px;
  width:38px;height:38px;border-radius:50%;
  background:var(--sticker-yellow);
  color:var(--ink);
  font-family:'Permanent Marker',cursive;
  font-size:8px;line-height:1.1;
  display:flex;align-items:center;justify-content:center;text-align:center;
  transform:rotate(-14deg);
  box-shadow:0 1px 3px rgba(0,0,0,.5);
  z-index:2;
}
.case-label{
  margin-top:6px;
  font-size:10.5px;line-height:1.3;color:#cbbfa4;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.case-year{font-size:9.5px;color:#7a6c52}

/* ── Staff picks corkboard ── */
.cork{
  background:
    radial-gradient(circle at 20% 30%, rgba(0,0,0,.12) 1px, transparent 2px),
    radial-gradient(circle at 70% 60%, rgba(0,0,0,.10) 1px, transparent 2px),
    linear-gradient(180deg,#9a713f,#845d31);
  background-size:60px 60px, 90px 90px, 100% 100%;
  border:10px solid var(--wood-dark);
  border-radius:4px;
  box-shadow:inset 0 0 30px rgba(0,0,0,.35), 0 6px 18px rgba(0,0,0,.5);
  padding:20px 14px 24px;
}
.cork-note{
  background:var(--paper);color:var(--ink);
  font-family:'Permanent Marker',cursive;font-size:13px;
  display:inline-block;padding:8px 14px;
  transform:rotate(-2deg);
  box-shadow:0 3px 6px rgba(0,0,0,.4);
  margin:0 14px 16px;
  position:relative;
}
.cork-note::before{
  content:'';position:absolute;top:-6px;left:18px;
  width:10px;height:10px;border-radius:50%;
  background:radial-gradient(circle at 35% 35%, #ff7a7a, #a41212);
  box-shadow:0 2px 3px rgba(0,0,0,.5);
}

/* ── Pulled-out case (modal) ── */
.pull-overlay{
  position:fixed;inset:0;z-index:200;
  background:rgba(10,7,5,.82);
  display:none;align-items:center;justify-content:center;
  padding:20px;
}
.pull-overlay.open{display:flex}
.pull-case{
  width:min(320px,86vw);
  perspective:1200px;
}
.pull-inner{
  position:relative;width:100%;
  transform-style:preserve-3d;
  transition:transform .55s cubic-bezier(.4,1.4,.6,1);
}
.pull-inner.flipped{transform:rotateY(180deg)}
.pull-face{
  backface-visibility:hidden;-webkit-backface-visibility:hidden;
  border-radius:3px 6px 6px 3px;
  box-shadow:0 18px 50px rgba(0,0,0,.8);
}
.pull-front{position:relative}
.pull-front img{width:100%;display:block;border-radius:3px 6px 6px 3px;aspect-ratio:2/3;object-fit:cover;background:#20202c}
.pull-front .no-art{
  aspect-ratio:2/3;display:flex;align-items:center;justify-content:center;
  padding:20px;text-align:center;
  font-family:'Permanent Marker',cursive;font-size:20px;color:var(--paper);
  background:linear-gradient(160deg,#3a3a4a,#20202c);
  border-radius:3px 6px 6px 3px;
}
.pull-back{
  position:absolute;inset:0;
  transform:rotateY(180deg);
  background:linear-gradient(170deg,#241d16,#171310);
  border:1px solid #3a2f22;
  color:#d8ccb2;
  padding:16px 16px 14px;
  font-size:12px;line-height:1.55;
  display:flex;flex-direction:column;
  overflow:hidden;
}
.pull-back h2{
  font-size:15px;color:var(--lamp);margin-bottom:2px;line-height:1.25;
  font-weight:700;
}
.pull-back .da-title{font-style:italic;color:#9a8b6c;font-size:11px;margin-bottom:8px}
.pull-back .synopsis{
  flex:1;overflow-y:auto;margin-bottom:10px;
  color:#cbbfa4;
}
.pull-back .meta-line{font-size:10.5px;color:#8a7a60;margin-bottom:3px}
.pull-back .meta-line b{color:#b8a988;font-weight:600}
.watched-stamp{
  position:absolute;top:12px;right:12px;
  border:2px solid;
  border-radius:3px;
  font-family:'Permanent Marker',cursive;
  font-size:11px;
  padding:2px 7px;
  transform:rotate(9deg);
  opacity:.9;
}
.stamp-yes{color:#7ec98a;border-color:#7ec98a}
.stamp-no{color:var(--sticker-yellow);border-color:var(--sticker-yellow)}
.barcode{
  height:26px;margin-top:auto;
  background:repeating-linear-gradient(90deg,#d8ccb2 0 2px,transparent 2px 4px,#d8ccb2 4px 7px,transparent 7px 9px,#d8ccb2 9px 10px,transparent 10px 14px);
  opacity:.75;
}
.pull-hint{
  text-align:center;margin-top:14px;
  font-family:'Permanent Marker',cursive;
  font-size:12px;color:#b8a988;
}
.pull-close{
  position:absolute;top:-14px;right:-14px;z-index:5;
  width:34px;height:34px;border-radius:50%;
  background:var(--sticker-red);color:var(--paper);
  border:none;font-size:17px;line-height:1;cursor:pointer;
  box-shadow:0 3px 8px rgba(0,0,0,.6);
}

/* ── Footer ── */
.shop-footer{
  text-align:center;padding:50px 16px 60px;
  font-family:'Permanent Marker',cursive;
  color:#6b5c44;font-size:13px;
}
.empty-note{color:#8a7a60;font-size:13px;padding:8px 14px 30px;font-style:italic}
</style>
</head>
<body>

<header class="storefront">
  <a class="back-link" href="index.html">← To the collection</a>
  <div class="neon">Be Kind, Rewind</div>
  <div class="neon-sub">VIDEO RENTAL</div>
  <br>
  <div class="hours-card">OPEN EVERY DAY 3–10 PM · NEW FILMS EVERY FRIDAY</div>
</header>

<div class="counter">
  <div class="search-card">
    <label for="q">Looking for something? Ask at the counter:</label>
    <input id="q" type="text" placeholder="Title, director or actor…" autocomplete="off">
  </div>
</div>

<nav class="aisle-nav" id="aisle-nav"></nav>
<main id="store"></main>

<footer class="shop-footer">Don't forget to rewind.</footer>

<div class="pull-overlay" id="pull-overlay">
  <div class="pull-case">
    <div class="pull-inner" id="pull-inner">
      <button class="pull-close" id="pull-close" aria-label="Put the film back">×</button>
      <div class="pull-face pull-front" id="pull-front"></div>
      <div class="pull-face pull-back" id="pull-back"></div>
    </div>
    <div class="pull-hint" id="pull-hint">Click the cover to turn the case over</div>
  </div>
</div>

<script>
const CSV_URL = 'https://raw.githubusercontent.com/wonderdk/bekindrewind/main/movies.csv';
const TMDB_TOKEN = 'eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiIxZTY3N2ZiMTVjMGM4ZDBkNTMzNjQzMGYxNmNlOTFmMiIsIm5iZiI6MTc3NjQxMjk3Mi4zMDIsInN1YiI6IjY5ZTFlOTJjNmJlM2VmOWRmZThiN2I1MCIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.LmxBN4pTZr1OsghaHWA2LkbrqJrGNqftKmyQ1ZUNOQA';

/* Section definitions. A film lands in exactly ONE section: the first whose
   genre set intersects the film's genres. Order encodes shop logic:
   the gysere never end up on the children's shelf. */
const SECTIONS = [
  { id:'horror',   label:'Horror',            genres:['Horror'] },
  { id:'scifi',    label:'Science Fiction',   genres:['Sci-Fi','Science Fiction'] },
  { id:'crime',    label:'Crime',             genres:['Crime'] },
  { id:'thriller', label:'Thriller',          genres:['Thriller','Mystery'] },
  { id:'action',   label:'Action',            genres:['Action','War','Western'] },
  { id:'fantasy',  label:'Fantasy & Adventure', genres:['Fantasy','Adventure'] },
  { id:'kids',     label:'Animation & Kids',  genres:['Animation','Family'] },
  { id:'comedy',   label:'Comedy',            genres:['Comedy','Music'] },
  { id:'drama',    label:'Drama',             genres:['Drama','Romance','History','Documentary'] },
  { id:'misc',     label:'Miscellaneous',     genres:[] } /* catch-all */
];

let movies = [];
const overviewCache = new Map();

function parseCSV(text) {
  const rows = [];
  const lines = text.trim().split('\n');
  const parseLine = (line) => {
    const vals = [];
    let cur = '', inQ = false;
    for (let j = 0; j < line.length; j++) {
      const c = line[j];
      if (c === '"') {
        if (inQ && line[j+1] === '"') { cur += '"'; j++; continue; }
        inQ = !inQ; continue;
      }
      if (c === ',' && !inQ) { vals.push(cur.trim()); cur = ''; continue; }
      cur += c;
    }
    vals.push(cur.trim());
    return vals;
  };
  const headers = parseLine(lines[0]);
  for (let i = 1; i < lines.length; i++) {
    if (!lines[i].trim()) continue;
    const vals = parseLine(lines[i]);
    if (vals.length < headers.length) continue;
    const obj = {};
    headers.forEach((h, idx) => obj[h] = vals[idx] || '');
    if (obj.uid) rows.push(obj);
  }
  return rows;
}

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function fmtClass(f) { return 'f-' + String(f || '').replace(/\s+/g,''); }

function sectionFor(m) {
  const genres = (m.genre_ids || '').split('|').map(g => g.trim()).filter(Boolean);
  for (const s of SECTIONS) {
    if (s.genres.some(g => genres.includes(g))) return s.id;
  }
  return 'misc';
}

/* Date-seeded shuffle so staff picks rotate daily but stay stable within a day */
function seededPicks(pool, n) {
  const d = new Date();
  let seed = d.getFullYear() * 10000 + (d.getMonth()+1) * 100 + d.getDate();
  const rand = () => { seed = (seed * 9301 + 49297) % 233280; return seed / 233280; };
  const arr = pool.slice();
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr.slice(0, n);
}

function caseHtml(m) {
  const art = m.poster_url
    ? `<img src="${escHtml(m.poster_url)}" alt="" loading="lazy" onerror="this.style.display='none'">
       <div class="no-art" style="z-index:-1">${escHtml(m.title)}</div>`
    : `<div class="no-art">${escHtml(m.title)}</div>`;
  const sticker = m.watched === 'true' ? '' : '<div class="sticker">NOT<br>SEEN</div>';
  return `
    <button class="case" data-uid="${escHtml(m.uid)}">
      <div class="case-art ${fmtClass(m.format)}">
        ${sticker}
        ${art}
      </div>
      <div class="case-label">${escHtml(m.title)}</div>
      <div class="case-year">${escHtml(m.year)} · ${escHtml(m.format)}</div>
    </button>`;
}

function shelfRows(list) {
  /* fixed rows of a shelf unit; each row scrolls sideways like walking past it */
  const perRow = 24;
  let html = '';
  for (let i = 0; i < list.length; i += perRow) {
    html += `<div class="shelf-row">${list.slice(i, i + perRow).map(caseHtml).join('')}</div>`;
  }
  return html;
}

function render(filter) {
  const q = (filter || '').toLowerCase().trim();
  const match = (m) => !q
    || m.title.toLowerCase().includes(q)
    || (m.title_da || '').toLowerCase().includes(q)
    || (m.director || '').toLowerCase().includes(q)
    || (m.actors || '').toLowerCase().includes(q);

  const visible = movies.filter(m => m.hidden !== 'true' && match(m));

  const buckets = {};
  SECTIONS.forEach(s => buckets[s.id] = []);
  visible.forEach(m => buckets[sectionFor(m)].push(m));
  SECTIONS.forEach(s => buckets[s.id].sort((a,b) => a.title.localeCompare(b.title)));

  const store = document.getElementById('store');
  const nav = document.getElementById('aisle-nav');
  let storeHtml = '';
  let navHtml = '';

  /* New arrivals: highest uids, only when not searching */
  if (!q) {
    const newest = movies.filter(m => m.hidden !== 'true')
      .slice().sort((a,b) => (parseInt(b.uid)||0) - (parseInt(a.uid)||0)).slice(0, 12);
    storeHtml += `
      <section class="aisle" id="sec-nyheder">
        <div class="aisle-header"><h2 class="aisle-title">New on the shelf</h2></div>
        <div class="shelf-unit">${shelfRows(newest)}</div>
      </section>`;
    navHtml += `<a class="aisle-sign" href="#sec-nyheder">New arrivals</a>`;

    const unwatchedPool = movies.filter(m => m.hidden !== 'true' && m.watched !== 'true' && m.poster_url);
    const picks = seededPicks(unwatchedPool, 6);
    if (picks.length) {
      storeHtml += `
        <section class="aisle" id="sec-picks">
          <div class="aisle-header"><h2 class="aisle-title">Staff picks for tonight</h2></div>
          <div class="cork">
            <div class="cork-note">None of these have been in the machine yet. Changes daily!</div>
            <div class="shelf-row" style="border-bottom:none;padding-top:4px">${picks.map(caseHtml).join('')}</div>
          </div>
        </section>`;
      navHtml += `<a class="aisle-sign" href="#sec-picks">Staff picks</a>`;
    }
  }

  for (const s of SECTIONS) {
    const list = buckets[s.id];
    if (!list.length) continue;
    navHtml += `<a class="aisle-sign" href="#sec-${s.id}">${s.label}<span class="count">${list.length}</span></a>`;
    storeHtml += `
      <section class="aisle" id="sec-${s.id}">
        <div class="aisle-header">
          <h2 class="aisle-title">${s.label}</h2>
          <span class="aisle-count">${list.length} films</span>
        </div>
        <div class="shelf-unit">${shelfRows(list)}</div>
      </section>`;
  }

  if (!visible.length) {
    storeHtml = `<p class="empty-note" style="text-align:center;padding-top:40px">Sorry, we don't have that one in. Try another word at the counter.</p>`;
  }

  nav.innerHTML = navHtml;
  store.innerHTML = storeHtml;
}

/* ── Pulled-out case ── */
const overlay = document.getElementById('pull-overlay');
const inner = document.getElementById('pull-inner');

async function fetchOverview(m) {
  if (overviewCache.has(m.uid)) return overviewCache.get(m.uid);
  if (!/^tt\d{7,8}$/.test(m.imdb_id) || m.imdb_id === 'tt0000000') return '';
  try {
    const hdrs = { Authorization: `Bearer ${TMDB_TOKEN}` };
    const f = await fetch(`https://api.themoviedb.org/3/find/${m.imdb_id}?external_source=imdb_id`, { headers: hdrs }).then(r => r.json());
    const id = f.movie_results?.[0]?.id;
    if (!id) return '';
    const d = await fetch(`https://api.themoviedb.org/3/movie/${id}`, { headers: hdrs }).then(r => r.json());
    const ov = d.overview || '';
    overviewCache.set(m.uid, ov);
    return ov;
  } catch(e) { return ''; }
}

async function pullCase(uid) {
  const m = movies.find(x => x.uid === uid);
  if (!m) return;
  const front = document.getElementById('pull-front');
  const back = document.getElementById('pull-back');
  inner.classList.remove('flipped');

  front.innerHTML = m.poster_url
    ? `<img src="${escHtml(m.poster_url.replace('/w300','/w500'))}" alt="${escHtml(m.title)}">`
    : `<div class="no-art">${escHtml(m.title)}</div>`;

  const watched = m.watched === 'true';
  const actors = (m.actors || '').split('|').filter(a => a && a !== '-').join(', ');
  back.innerHTML = `
    <div class="watched-stamp ${watched ? 'stamp-yes' : 'stamp-no'}">${watched ? 'SEEN' : 'NOT SEEN'}</div>
    <h2>${escHtml(m.title)}</h2>
    ${m.title_da && m.title_da !== m.title ? `<div class="da-title">${escHtml(m.title_da)}</div>` : '<div class="da-title"></div>'}
    <div class="synopsis" id="pull-synopsis">Fetching the back-cover text…</div>
    ${m.director ? `<div class="meta-line"><b>Director:</b> ${escHtml(m.director)}</div>` : ''}
    ${actors ? `<div class="meta-line"><b>Starring:</b> ${escHtml(actors)}</div>` : ''}
    <div class="meta-line"><b>${escHtml(m.year)}</b> · ${escHtml(m.format)}${m.runtime && m.runtime !== '0' ? ` · ${escHtml(m.runtime)} min` : ''}${m.box_set ? ` · From the box set: ${escHtml(m.box_set)}` : ''}</div>
    <div class="barcode"></div>`;

  overlay.classList.add('open');

  const ov = await fetchOverview(m);
  const syn = document.getElementById('pull-synopsis');
  if (syn) syn.textContent = ov || 'The back-cover text has gone missing. Ask at the counter.';
}

document.getElementById('store').addEventListener('click', e => {
  const btn = e.target.closest('.case');
  if (btn) pullCase(btn.dataset.uid);
});
inner.addEventListener('click', e => {
  if (e.target.id === 'pull-close') return;
  inner.classList.toggle('flipped');
});
document.getElementById('pull-close').addEventListener('click', () => overlay.classList.remove('open'));
overlay.addEventListener('click', e => { if (e.target === overlay) overlay.classList.remove('open'); });
document.addEventListener('keydown', e => { if (e.key === 'Escape') overlay.classList.remove('open'); });

let searchTimer;
document.getElementById('q').addEventListener('input', e => {
  clearTimeout(searchTimer);
  searchTimer = setTimeout(() => render(e.target.value), 150);
});

(async function init() {
  try {
    const res = await fetch(CSV_URL + '?t=' + Date.now());
    movies = parseCSV(await res.text());
    render('');
  } catch(e) {
    document.getElementById('store').innerHTML = '<p class="empty-note" style="text-align:center;padding-top:40px">The shop could not open. Try reloading the page.</p>';
  }
})();
</script>
